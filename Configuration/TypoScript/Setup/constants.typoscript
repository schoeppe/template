path {
    test {
        layouts     = EXT:template/Resources/Private/Layouts/Test/
        partials    = EXT:template/Resources/Private/Partials/Test/
        templates   = EXT:template/Resources/Private/Templates/Test/
        dist        = EXT:template/Resources/Public/Test/dist/
        favicons    = EXT:template/Resources/Public/Test/dist/assets/favicons/
        css         = EXT:template/Resources/Public/Test/dist/assets/css/app.css
        js          = EXT:template/Resources/Public/Test/dist/assets/js/app.js
    }
    default {
        layouts     = EXT:template/Resources/Private/Layouts/Page/
        partials    = EXT:template/Resources/Private/Partials/Page/
        templates   = EXT:template/Resources/Private/Templates/Page/
    }
}



